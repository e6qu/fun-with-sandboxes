+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package darwinstats
+
+import (
+	"fmt"
+	"syscall"
+	"unsafe"
+)
+
+// The kernel's host statistics are Mach calls libSystem makes; call them
+// as golang.org/x/sys/unix calls libSystem, without cgo.
+
+func syscall_syscall6(fn, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err syscall.Errno)
+
+//go:linkname syscall_syscall6 syscall.syscall6
+
+var libc_mach_host_self_trampoline_addr uintptr
+
+//go:cgo_import_dynamic libc_mach_host_self mach_host_self "/usr/lib/libSystem.B.dylib"
+
+var libc_host_statistics64_trampoline_addr uintptr
+
+//go:cgo_import_dynamic libc_host_statistics64 host_statistics64 "/usr/lib/libSystem.B.dylib"
+
+// Flavors and counts of host_statistics64 (mach/host_info.h).
+const (
+	hostCPULoadInfo      = 3
+	hostCPULoadInfoCount = 4
+	hostVMInfo64         = 4
+	hostVMInfo64Count    = 38
+)
+
+// cpuLoad is host_cpu_load_info: ticks every CPU spent in each state.
+type cpuLoad struct {
+	user, system, idle, nice uint32
+}
+
+// vmStatistics64 is struct vm_statistics64 (mach/vm_statistics.h).
+type vmStatistics64 struct {
+	freeCount, activeCount, inactiveCount, wireCount  uint32
+	zeroFillCount, reactivations, pageins, pageouts   uint64
+	faults, cowFaults, lookups, hits, purges          uint64
+	purgeableCount, speculativeCount                  uint32
+	decompressions, compressions, swapins, swapouts   uint64
+	compressorPageCount, throttledCount               uint32
+	externalPageCount, internalPageCount              uint32
+	totalUncompressedPagesInCompressor                uint64
+}
+
+var host = func() uintptr {
+	r, _, _ := syscall_syscall6(libc_mach_host_self_trampoline_addr, 0, 0, 0, 0, 0, 0)
+	return r
+}()
+
+func hostStatistics(flavor int, info unsafe.Pointer, count uint32) error {
+	n := count
+	r, _, _ := syscall_syscall6(libc_host_statistics64_trampoline_addr, host, uintptr(flavor), uintptr(info), uintptr(unsafe.Pointer(&n)), 0, 0)
+	if r != 0 {
+		return fmt.Errorf("host_statistics64 flavor %d: kern_return_t %d", flavor, r)
+	}
+	return nil
+}
+
+func readCPULoad() (cpuLoad, error) {
+	var l cpuLoad
+	return l, hostStatistics(hostCPULoadInfo, unsafe.Pointer(&l), hostCPULoadInfoCount)
+}
+
+func readVMStatistics() (vmStatistics64, error) {
+	var v vmStatistics64
+	return v, hostStatistics(hostVMInfo64, unsafe.Pointer(&v), hostVMInfo64Count)
+}
