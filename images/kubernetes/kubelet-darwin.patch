diff --git a/pkg/kubelet/darwinstats/darwinstats.go b/pkg/kubelet/darwinstats/darwinstats.go
new file mode 100644
index 00000000..7795eca0
--- /dev/null
+++ b/pkg/kubelet/darwinstats/darwinstats.go
@@ -0,0 +1,249 @@
+//go:build darwin
+
+/*
+Copyright 2026 The Kubernetes Authors.
+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+// Package darwinstats reads a macOS node's machine information and its
+// CPU, memory and filesystem usage from the kernel, in cAdvisor's shapes,
+// as winstats does for a Windows node.
+package darwinstats
+
+import (
+	"encoding/binary"
+	"fmt"
+	"sync"
+	"time"
+
+	cadvisorapi "github.com/google/cadvisor/info/v1"
+	cadvisorapiv2 "github.com/google/cadvisor/info/v2"
+	"golang.org/x/sys/unix"
+)
+
+// Client reads the node's statistics.
+type Client struct {
+	mu      sync.Mutex
+	started time.Time
+	prev    *cadvisorapiv2.ContainerStats
+}
+
+// NewClient returns a client for the node it runs on.
+func NewClient() (*Client, error) {
+	boot, err := unix.SysctlTimeval("kern.boottime")
+	if err != nil {
+		return nil, fmt.Errorf("kern.boottime: %w", err)
+	}
+	return &Client{started: time.Unix(boot.Unix())}, nil
+}
+
+func sysctlUint64(name string) (uint64, error) {
+	v, err := unix.SysctlUint64(name)
+	if err != nil {
+		return 0, fmt.Errorf("sysctl %s: %w", name, err)
+	}
+	return v, nil
+}
+
+func sysctlUint32(name string) (uint32, error) {
+	v, err := unix.SysctlUint32(name)
+	if err != nil {
+		return 0, fmt.Errorf("sysctl %s: %w", name, err)
+	}
+	return v, nil
+}
+
+// MachineInfo describes the node's processors, memory and identity.
+func (c *Client) MachineInfo() (*cadvisorapi.MachineInfo, error) {
+	cores, err := sysctlUint32("hw.logicalcpu")
+	if err != nil {
+		return nil, err
+	}
+	physical, err := sysctlUint32("hw.physicalcpu")
+	if err != nil {
+		return nil, err
+	}
+	packages, err := sysctlUint32("hw.packages")
+	if err != nil {
+		return nil, err
+	}
+	memory, err := sysctlUint64("hw.memsize")
+	if err != nil {
+		return nil, err
+	}
+	// struct xsw_usage: total, available and used bytes of swap.
+	swap, err := unix.SysctlRaw("vm.swapusage")
+	if err != nil || len(swap) < 8 {
+		return nil, fmt.Errorf("sysctl vm.swapusage: %v", err)
+	}
+	machineID, err := unix.Sysctl("kern.uuid")
+	if err != nil {
+		return nil, fmt.Errorf("sysctl kern.uuid: %w", err)
+	}
+	bootID, err := unix.Sysctl("kern.bootsessionuuid")
+	if err != nil {
+		return nil, fmt.Errorf("sysctl kern.bootsessionuuid: %w", err)
+	}
+	// Apple silicon publishes no CPU frequency.
+	var khz uint64
+	if hz, err := unix.SysctlUint64("hw.cpufrequency"); err == nil {
+		khz = hz / 1000
+	}
+	vendor, _ := unix.Sysctl("machdep.cpu.brand_string")
+	return &cadvisorapi.MachineInfo{
+		Timestamp:        time.Now(),
+		CPUVendorID:      vendor,
+		NumCores:         int(cores),
+		NumPhysicalCores: int(physical),
+		NumSockets:       int(packages),
+		CpuFrequency:     khz,
+		MemoryCapacity:   memory,
+		SwapCapacity:     binary.LittleEndian.Uint64(swap[:8]),
+		MachineID:        machineID,
+		SystemUUID:       machineID,
+		BootID:           bootID,
+	}, nil
+}
+
+// VersionInfo names the node's kernel and operating system.
+func (c *Client) VersionInfo() (*cadvisorapi.VersionInfo, error) {
+	kernel, err := unix.Sysctl("kern.osrelease")
+	if err != nil {
+		return nil, fmt.Errorf("sysctl kern.osrelease: %w", err)
+	}
+	product, err := unix.Sysctl("kern.osproductversion")
+	if err != nil {
+		return nil, fmt.Errorf("sysctl kern.osproductversion: %w", err)
+	}
+	return &cadvisorapi.VersionInfo{KernelVersion: kernel, ContainerOsVersion: "macOS " + product}, nil
+}
+
+// tickNanos is how long one of the scheduler's statistics ticks lasts.
+func tickNanos() (uint64, error) {
+	// struct clockinfo begins with hz, the ticks in a second.
+	b, err := unix.SysctlRaw("kern.clockrate")
+	if err != nil || len(b) < 4 {
+		return 0, fmt.Errorf("sysctl kern.clockrate: %v", err)
+	}
+	hz := binary.LittleEndian.Uint32(b[:4])
+	if hz == 0 {
+		return 0, fmt.Errorf("sysctl kern.clockrate: hz is 0")
+	}
+	return uint64(time.Second) / uint64(hz), nil
+}
+
+// sample reads the node's CPU time and memory now.
+func (c *Client) sample() (*cadvisorapiv2.ContainerStats, error) {
+	load, err := readCPULoad()
+	if err != nil {
+		return nil, err
+	}
+	vm, err := readVMStatistics()
+	if err != nil {
+		return nil, err
+	}
+	tick, err := tickNanos()
+	if err != nil {
+		return nil, err
+	}
+	page, err := sysctlUint64("hw.pagesize")
+	if err != nil {
+		return nil, err
+	}
+	user := (uint64(load.user) + uint64(load.nice)) * tick
+	system := uint64(load.system) * tick
+	// Memory in use is what Activity Monitor calls Memory Used: pages apps
+	// hold, pages the kernel wires and pages the compressor holds.
+	anonymous := uint64(vm.internalPageCount)
+	if p := uint64(vm.purgeableCount); p < anonymous {
+		anonymous -= p
+	}
+	used := (anonymous + uint64(vm.wireCount) + uint64(vm.compressorPageCount)) * page
+	// The page cache, file-backed pages, can be reclaimed.
+	cache := uint64(vm.externalPageCount) * page
+	return &cadvisorapiv2.ContainerStats{
+		Timestamp: time.Now(),
+		Cpu: &cadvisorapi.CpuStats{Usage: cadvisorapi.CpuUsage{
+			Total: user + system, User: user, System: system,
+		}},
+		Memory: &cadvisorapi.MemoryStats{
+			Usage:      used + cache,
+			Cache:      cache,
+			RSS:        anonymous * page,
+			WorkingSet: used,
+			ContainerData: cadvisorapi.MemoryStatsMemoryData{
+				Pgfault:    vm.faults,
+				Pgmajfault: vm.pageins,
+			},
+		},
+	}, nil
+}
+
+// RootInfo is the node's root container: its capacity and its two most
+// recent samples, the earlier taken by the previous call, whose difference
+// is the CPU it uses now.
+func (c *Client) RootInfo() (cadvisorapiv2.ContainerInfo, error) {
+	m, err := c.MachineInfo()
+	if err != nil {
+		return cadvisorapiv2.ContainerInfo{}, err
+	}
+	cur, err := c.sample()
+	if err != nil {
+		return cadvisorapiv2.ContainerInfo{}, err
+	}
+	c.mu.Lock()
+	prev := c.prev
+	c.prev = cur
+	c.mu.Unlock()
+	stats := []*cadvisorapiv2.ContainerStats{cur}
+	if prev != nil {
+		if d := cur.Timestamp.Sub(prev.Timestamp); d > 0 && cur.Cpu.Usage.Total >= prev.Cpu.Usage.Total {
+			cur.CpuInst = &cadvisorapiv2.CpuInstStats{Usage: cadvisorapiv2.CpuInstUsage{
+				Total:  (cur.Cpu.Usage.Total - prev.Cpu.Usage.Total) * uint64(time.Second) / uint64(d),
+				User:   (cur.Cpu.Usage.User - prev.Cpu.Usage.User) * uint64(time.Second) / uint64(d),
+				System: (cur.Cpu.Usage.System - prev.Cpu.Usage.System) * uint64(time.Second) / uint64(d),
+			}}
+		}
+		stats = []*cadvisorapiv2.ContainerStats{prev, cur}
+	}
+	return cadvisorapiv2.ContainerInfo{
+		Spec: cadvisorapiv2.ContainerSpec{
+			CreationTime: c.started,
+			HasCpu:       true,
+			HasMemory:    true,
+			Memory:       cadvisorapiv2.MemorySpec{Limit: m.MemoryCapacity},
+		},
+		Stats: stats,
+	}, nil
+}
+
+// FsInfo is the capacity and use of the filesystem path is on.
+func FsInfo(path string) (cadvisorapiv2.FsInfo, error) {
+	var s unix.Statfs_t
+	if err := unix.Statfs(path, &s); err != nil {
+		return cadvisorapiv2.FsInfo{}, fmt.Errorf("statfs %s: %w", path, err)
+	}
+	bsize := uint64(s.Bsize)
+	inodes, free := s.Files, s.Ffree
+	return cadvisorapiv2.FsInfo{
+		Timestamp:  time.Now(),
+		Device:     unix.ByteSliceToString(s.Mntfromname[:]),
+		Mountpoint: unix.ByteSliceToString(s.Mntonname[:]),
+		Capacity:   s.Blocks * bsize,
+		Available:  s.Bavail * bsize,
+		Usage:      (s.Blocks - s.Bfree) * bsize,
+		Inodes:     &inodes,
+		InodesFree: &free,
+	}, nil
+}
diff --git a/pkg/kubelet/darwinstats/libsystem_darwin.go b/pkg/kubelet/darwinstats/libsystem_darwin.go
