# The official image's /etc/mysql/my.cnf. The entry names the server's own
# paths on its command line, which override these; the directories below
# hold a user's own settings, mounted or copied in.
[client-server]
socket=/run/mysqld/mysqld.sock

!includedir /etc/mysql/mariadb.conf.d/
!includedir /etc/mysql/conf.d/
