+// builtinSyntax reports whether a # syntax= directive names Docker's own
+// Dockerfile frontend, which this frontend is: its images are Linux images,
+// which a darwin worker cannot run, so the built-in frontend serves the
+// Dockerfile instead of forwarding to one.
+func builtinSyntax(ref string) bool {
+	ref = strings.TrimPrefix(strings.TrimPrefix(ref, "docker.io/"), "index.docker.io/")
+	if i := strings.IndexAny(ref, "@"); i >= 0 {
+		ref = ref[:i]
+	}
+	if i := strings.LastIndex(ref, ":"); i > strings.LastIndex(ref, "/") {
+		ref = ref[:i]
+	}
+	return ref == "docker/dockerfile" || ref == "docker/dockerfile-upstream"
+}
